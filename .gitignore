# =============================================================
#  iwrv.net  .gitignore
#
#  このリポジトリは GitHub Pages で全世界に公開されています。
#  ここに書いたものは「git add . を誤って叩いたとき」に
#  commit されなくなります。
#
#  ただし .gitignore は「まだ追跡されていないファイル」にしか
#  効きません。すでに commit 済みのファイルは、ここに書いても
#  公開され続けます。確認方法はこのファイルの末尾を参照。
# =============================================================


# -------------------------------------------------------------
#  1. 認証情報 — 最優先
# -------------------------------------------------------------
#  Search Console API / Google API のキー類。
#  1件でも公開リポジトリに入ったら、ファイルを消すだけでは不十分です。
#  Google Cloud コンソールでそのキーを必ず失効させてください。

*.pem
*.p12
*.pfx
*.key
*.keyfile

.env
.env.*

credentials.json
client_secret*.json
service-account*.json
service_account*.json
*-service-account.json
*-serviceaccount.json
token.json
tokens.json
refresh_token*
oauth*.json
gsc-*.json
gsc_*.json

secrets/
.secrets/
.credentials/


# -------------------------------------------------------------
#  2. Git管理外の制作・本番フォルダ
# -------------------------------------------------------------
#  deploy.ps1 の $Forbidden と同じ顔ぶれです。

acrylic-base/
business-card/
cd-jacket/
live-ticket/
output/
public-samples/
tmp/
_backup/


# -------------------------------------------------------------
#  3. AIツールの作業ディレクトリ
# -------------------------------------------------------------

.agents/
.codex/
.claude/
Claude outputs/


# -------------------------------------------------------------
#  4. 引き継ぎ書・内部メモ
# -------------------------------------------------------------
#  ローカルの絶対パス（D:\...）や事故履歴を含むため、
#  公開リポジトリには置きません。

CLAUDE_HANDOFF.md
CODEX_HANDOFF.md
SITE_IMPROVEMENT_PLAN.md
GOOGLE_FORM_TEMPLATE.md


# -------------------------------------------------------------
#  5. 公開スクリプト（ローカル専用）
# -------------------------------------------------------------

deploy.ps1
deploy.bat


# -------------------------------------------------------------
#  6. 旧Hero立ち絵（2.2MB・現在どこからも参照されていない）
# -------------------------------------------------------------

ai-winston-rucker-main.PNG


# -------------------------------------------------------------
#  7. OS / エディタが勝手に作るもの
# -------------------------------------------------------------

.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
.vscode/
.idea/
*.swp
*.swo
*~


# =============================================================
#  すでに commit 済みのものを確認するには
# =============================================================
#
#  リポジトリのフォルダで PowerShell を開いて、
#
#      git ls-files
#
#  と打つと、いま追跡されているファイルの一覧が出ます。
#  この .gitignore に書いたものが混ざっていたら、
#
#      git rm --cached <ファイル名>
#
#  で追跡から外し、deploy.bat で push してください
#  （--cached を付ければローカルのファイルは消えません）。
#
#  注意: 過去にキーを commit していた場合、追跡から外しても
#  Git の履歴には残ります。その場合はキーの失効が唯一の対処です。
# =============================================================
